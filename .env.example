# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual infrastructure values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Credentials & Region
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_DEFAULT_REGION=ap-southeast-2

# ------------------------------------------------------------------------------
# 2. S3 Lakehouse & Pipeline Target Settings
# ------------------------------------------------------------------------------
S3_BUCKET=musicbrainz-etl-project-luc
RAW_BUCKET=musicbrainz-etl-project-luc
GLUE_IAM_ROLE=AWSGlueServiceRole-musicbrainz-s3-glue-role
ATHENA_DATABASE=musicbrainz_dw
S3_OUTPUT_LOCATION=s3://musicbrainz-etl-project-luc/athena-results/

# ------------------------------------------------------------------------------
# 3. Ingestion & API Compliance
# ------------------------------------------------------------------------------
USER_AGENT_EMAIL=your-email@gmail.com

# ------------------------------------------------------------------------------
# 4. Airflow Notifications & Alerting (SMTP)
# ------------------------------------------------------------------------------
ALERT_EMAIL=your-email@gmail.com
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=your-email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-app-password
AIRFLOW__SMTP__SMTP_MAIL_FROM=your-email@gmail.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False

# Airflow Provider Package
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-amazon==7.0.0
